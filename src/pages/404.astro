---
import Base from '../layouts/Base.astro';
import { path } from '../i18n/routes';
---
<Base lang="de" page="home" title="Seite nicht gefunden – ICS Editor" description="Diese Seite gibt es nicht." noindex canonical={false}>
  <article class="prose">
    <h1>Seite nicht gefunden</h1>
    <p>Diese Adresse gibt es nicht (mehr). <a href={path('home', 'de')}>Zum Werkzeug</a> · <a href={path('home', 'en')} lang="en">Open the tool (English)</a></p>
    <p>Vielleicht hilft einer der <a href={path('guides', 'de')}>Ratgeber zu Google Kalender</a> oder das <a href={path('glossary', 'de')}>ICS-Glossar</a>.</p>
    <p lang="en">Looking for help? See the <a href={path('guides', 'en')}>Google Calendar guides</a> or the <a href={path('glossary', 'en')}>ICS glossary</a>.</p>
  </article>
</Base>
